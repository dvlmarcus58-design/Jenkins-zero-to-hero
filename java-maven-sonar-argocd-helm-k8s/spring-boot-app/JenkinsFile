pipeline {
    agent any

    environment {
        GIT_USER_NAME = 'dvlmarcus58-design' // Your GitHub username
        GIT_USER_EMAIL = 'your_email@example.com' // Your GitHub email
        GITHUB_TOKEN = credentials('github') // Jenkins secret for GitHub token
        DOCKER_IMAGE = "dvlmarcus58/ultimate-cicd"
    }

    stages {

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${BUILD_NUMBER}")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
                        docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}").push()
                    }
                }
            }
        }

        stage('Update Deployment File and Push Git Changes') {
            steps {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    script {
                        dir("${env.WORKSPACE}") {

                            // Detect current Git branch
                            def branch = sh(script: "git rev-parse --abbrev-ref HEAD", returnStdout: true).trim()
                            echo "Current branch: ${branch}"

                            // Configure Git
                            sh "git config user.name '${GIT_USER_NAME}'"
                            sh "git config user.email '${GIT_USER_EMAIL}'"

                            // Update deployment file with new image tag
                            sh """
                                sed -i 's/replaceImageTag/${BUILD_NUMBER}/g' java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                            """

                            // Commit & push changes
                            sh 'git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml'
                            sh 'git commit -m "Update deployment image to version ${BUILD_NUMBER}" || echo "No changes to commit"'
                            sh "git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/Jenkins-zero-to-hero.git ${branch}"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished"
        }
        success {
            echo "Build succeeded!"
        }
        failure {
            echo "Build failed!"
        }
    }
}
